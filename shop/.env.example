# ============================================================================
# SwapnoPay Storefront Enterprise Configuration (.env)
# ============================================================================

# Database Driver: 'pgsql' (PostgreSQL / Supabase / VPS) or 'mysql'
DB_DRIVER=pgsql

# Multi-tenant Merchant ID (linked to public.merchants table)
MERCHANT_ID=

# ── Option 1: Direct Database Connection URL (Recommended for VPS / Supabase) ──
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/swapnopay_shop?sslmode=disable
# Or Supabase Pooler:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── Option 2: Individual Database Connection Parameters ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swapnopay_shop
DB_USER=postgres
DB_PASS=YOUR_PASSWORD
DB_SSLMODE=disable

# Supabase Managed Database Parameters (Alternative)
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Supabase API Credentials (Optional: for realtime notifications & edge functions)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# SwapnoPay Backend API (Hosted on VPS or Cloud)
SWAPNOPAY_BACKEND_URL=https://api.swapnopay.top
SWAPNOPAY_API_KEY=

# Storefront Settings
STORE_BASE_URL=https://shop.swapnopay.top/
DEFAULT_CURRENCY=BDT
TIMEZONE=Asia/Dhaka

