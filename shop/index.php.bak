    <!-- Flash Sales / Deals of the Day -->
    <section class="flash-sales-section section-spacing">
        <div class="container">
            <h2 class="section-title">⚡ Flash Sales <span class="countdown" id="flash-sale-countdown"></span></h2>
            <div class="product-grid owl-carousel owl-theme flash-sale-carousel">
                <?php
                // Fetch products marked for flash sale or with special discounts
                // This would ideally be from a dedicated tbl_flash_sales table
                $statement_flash = $pdo->prepare("SELECT * FROM tbl_product WHERE p_is_active = 1 AND p_current_price < p_old_price ORDER BY RAND() LIMIT 8");
                $statement_flash->execute();
                $flash_products = $statement_flash->fetchAll(PDO::FETCH_ASSOC);

                if (!empty($flash_products)):
                    foreach ($flash_products as $row):
                        displayProductCard($row, $pdo); // Use the helper function
                    endforeach;
                else:
                    echo '<p class="text-center">No flash sales currently active. Stay tuned!</p>';
                endif;
                ?>
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <?php if ($home_featured_product_on_off == 1): ?>
    <section class="featured-products-section section-spacing">
        <div class="container">
            <h2 class="section-title"><?php echo htmlspecialchars($featured_product_title); ?></h2>
            <p class="section-subtitle"><?php echo htmlspecialchars($featured_product_subtitle); ?></p>
            <div class="product-grid">
                <?php
                $statement = $pdo->prepare("SELECT * FROM tbl_product WHERE p_is_featured=? AND p_is_active=? ORDER BY p_id DESC LIMIT {$total_featured_product_home}");
                $statement->execute(array(1, 1));
                $result = $statement->fetchAll(PDO::FETCH_ASSOC);
                foreach ($result as $row) {
                    displayProductCard($row, $pdo); // Use the helper function
