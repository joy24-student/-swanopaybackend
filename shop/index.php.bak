$review_feature_on_off = $settings['review_feature_on_off'] ?? 1; // Assuming this setting exists

// Helper function to display a product card
function displayProductCard($row, $pdo) {
    global $review_feature_on_off; // Access global setting

    // Calculate average rating
    // Calculate average rating
$avg_rating = 0;
$total_reviews_count = 0;
if ($review_feature_on_off == 1) { // Only fetch reviews if feature is on
    $statement_rating = $pdo->prepare(
        "SELECT AVG(rating) AS avg_rating, COUNT(review_id) AS total_count 
         FROM tbl_review 
         WHERE product_id=?"
    );
    $statement_rating->execute(array($row['p_id']));
    $rating_result = $statement_rating->fetch(PDO::FETCH_ASSOC);
    if ($rating_result['total_count'] > 0) {
        $avg_rating = round($rating_result['avg_rating']); // Round to nearest whole number for star display
        $total_reviews_count = $rating_result['total_count'];
    }
}
    ?>
    <div class="product-card-wrapper col-xs-6 col-sm-4 col-md-3">
        <a href="<?php echo BASE_URL; ?>product.php?id=<?php echo $row['p_id']; ?>" class="product-card">
            <div class="product-image-container">
                <img src="<?php echo BASE_URL; ?>assets/uploads/<?php echo htmlspecialchars($row['p_featured_photo']); ?>" alt="<?php echo htmlspecialchars($row['p_name']); ?>" loading="lazy">
                <?php if($row['p_old_price'] > 0 && $row['p_old_price'] > $row['p_current_price']): ?>
                    <div class="discount-badge">
                        <?php echo round((($row['p_old_price'] - $row['p_current_price']) / $row['p_old_price']) * 100); ?>% OFF
                    </div>
                <?php endif; ?>
            </div>
            <div class="product-info">
                <h4 class="product-name"><?php echo htmlspecialchars($row['p_name']); ?></h4>
                <div class="product-price">
                    <span class="current-price"><?php echo LANG_VALUE_1; ?><?php echo number_format($row['p_current_price'], 2); ?></span>
                    <?php if($row['p_old_price'] > 0): ?>
                        <span class="old-price"><?php echo LANG_VALUE_1; ?><?php echo number_format($row['p_old_price'], 2); ?></span>
                    <?php endif; ?>
                </div>
                <?php if ($review_feature_on_off == 1): ?>
                    <div class="product-rating">
                        <?php
                        if($avg_rating == 0) {
                            echo '<span class="no-rating">No reviews yet</span>';
                        } else {
                            for($i=1;$i<=5;$i++) {
                                if($i <= $avg_rating) {
                                    echo '<i class="fa fa-star"></i>';
                                } else {
                                    echo '<i class="fa fa-star-o"></i>';
                                }
                            }
                        }
                        ?>
                        <?php if ($total_reviews_count > 0): ?>
                            <span class="review-count">(<?php echo $total_reviews_count; ?>)</span>
                        <?php endif; ?>
                    </div>
                <?php endif; ?>
                <?php if($row['p_qty'] == 0): ?>
                    <div class="out-of-stock-label">Out Of Stock</div>
                <?php endif; ?>
            </div>
        </a>
    </div>
    <?php
}
?>

