                        <img src="<?php echo BASE_URL; ?>assets/uploads/<?php echo htmlspecialchars($row_tcat['tcat_photo'] ?? 'default-category-icon.png'); ?>" alt="<?php echo htmlspecialchars($row_tcat['tcat_name']); ?>">
