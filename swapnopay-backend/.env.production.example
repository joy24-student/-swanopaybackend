PORT=4000
NODE_ENV=production
TRUST_PROXY_HOPS=1

# ──────────────────────────────────────────────────────────────────────────────
# Admin Supabase (Platform Owner's Database)
# Get these from: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_SUPABASE_URL=https://YOUR_ADMIN_PROJECT_REF.supabase.co
ADMIN_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ADMIN_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────────────────────────
# Backend Security (Generate with: openssl rand -hex 32)
# ──────────────────────────────────────────────────────────────────────────────
# Admin Panel uses this to call /v1/admin/* endpoints (min 32 chars)
ADMIN_SECRET=generate-a-random-32-char-string-using-openssl-rand-hex-32

# Pepper added to all generated API key digests (min 32 chars)
API_KEY_PEPPER=generate-another-random-32-char-string-using-openssl-rand-hex-32

# Secret verified on incoming carrier SMS webhooks from Android phone (min 32 chars)
PAYMENT_WEBHOOK_SECRET=generate-webhook-secret-32-chars-using-openssl-rand-hex-32

# ──────────────────────────────────────────────────────────────────────────────
# CORS Configuration — Production Allowed Domains
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://pay.swapnopay.top,https://admin.swapnopay.top,https://shop.swapnopay.top,https://swapnopay.top,https://api.swapnopay.top

# ──────────────────────────────────────────────────────────────────────────────
# Email Receipts — Gmail OAuth2 (Nodemailer) - Optional
# ──────────────────────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=payment@swapnopay.top
GMAIL_FROM_NAME=SwapnoPay Payments
