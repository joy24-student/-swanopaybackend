PORT=4000
NODE_ENV=development
TRUST_PROXY_HOPS=1

# ──────────────────────────────────────────────────────────────────────────────
# Admin Supabase (Platform Owner's Database)
# Get these from: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_SUPABASE_URL=https://your-admin-project.supabase.co
ADMIN_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ADMIN_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────────────────────────
# Backend Security (all must be long random strings)
# ──────────────────────────────────────────────────────────────────────────────
# Admin Panel uses this to call /v1/admin/* endpoints (min 32 chars)
ADMIN_SECRET=change-me-to-a-random-string-at-least-32-chars

# Pepper added to all generated API key digests (min 32 chars)
API_KEY_PEPPER=change-me-to-another-random-string-32-chars

# Secret Supabase process-sms sends in X-Webhook-Secret when calling /v1/payment/verify
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-32-chars

# ──────────────────────────────────────────────────────────────────────────────
# Email Receipts — Gmail OAuth2 (Nodemailer)
# Guide: https://developers.google.com/gmail/api/quickstart/nodejs
# ──────────────────────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_FROM_EMAIL=payment@swapnopay.top
GMAIL_FROM_NAME=SwapnoPay Payments

# ──────────────────────────────────────────────────────────────────────────────
# CORS — allowed origins for Widget and Admin Panel
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://pay.swapnopay.top,https://admin.swapnopay.top

# ──────────────────────────────────────────────────────────────────────────────
# Gateway Receipt Service (gateway-service — email delivery fallback)
# ──────────────────────────────────────────────────────────────────────────────
RECEIPT_SERVICE_URL=http://localhost:8080
RECEIPT_SERVICE_API_KEY=sp_receipt_your-key-here
