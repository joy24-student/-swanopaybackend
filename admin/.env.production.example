# ──────────────────────────────────────────────────────────────────────────────
# Admin Supabase (Platform Owner's Database — gateway config, API keys, events, support)
# Get these from: Supabase Dashboard → your ADMIN project → Settings → API
# ──────────────────────────────────────────────────────────────────────────────
VITE_ADMIN_SUPABASE_URL=https://YOUR_ADMIN_PROJECT_REF.supabase.co
VITE_ADMIN_SUPABASE_ANON_KEY=YOUR_ADMIN_ANON_KEY

# ──────────────────────────────────────────────────────────────────────────────
# Merchant Supabase (used for ConnectSupabase OAuth flow — per-merchant DB)
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_ADMIN_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ADMIN_ANON_KEY

# ──────────────────────────────────────────────────────────────────────────────
# SwapnoPay Central Backend API URL (pre-configured for swapnopay.top)
# ──────────────────────────────────────────────────────────────────────────────
VITE_BACKEND_URL=https://pay.swapnopay.top
