# Copy to .env on the hosting server. Never commit populated credentials.
# Use 64 random hex characters for both SHOP_DB_PASSWORD and SHOP_CONFIG_KEY.
SHOP_DB_PASSWORD=
SHOP_CONFIG_KEY=
SHOP_SERVER_IPS=
SHOP_BASE_DOMAIN=shops.swapnopay.top
SHOP_BACKEND_URL=https://api.swapnopay.top
ACME_EMAIL=
ADMIN_SUPABASE_URL=
ADMIN_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SUPABASE_ANON_KEY=
ADMIN_SECRET=
API_KEY_PEPPER=
PAYMENT_WEBHOOK_SECRET=
ALLOWED_ORIGINS=https://swapnopay.top,https://www.swapnopay.top,https://admin.swapnopay.top
TRUST_PROXY_HOPS=1
# Comma-separated approved self-hosted Supabase auth hosts, if applicable.
SHOP_AUTH_HOSTS=
